library(rvest)
library(tidyverse)
library(stringr)
library(openxlsx)
library(dplyr)


excel_file <- file.path("C:", "Users/lawsonsd/Documents", "CVE_Test-Table-New.xlsx")
wb <- loadWorkbook(excel_file)

addWorksheet(wb, 'New NVD')

#needs to be by modfied date desc.
all_vendors <- c("Adobe", "Cisco", "Apple", "Mozilla", "Microsoft")
source <- c()
all_links <- c()
all_desc <- c()
all_cve <- c()
all_titles <- c()
df1 <- data.frame()
df2 <- data.frame()
dff <- data.frame()

#GET URL
base_url_nist <- "https://nvd.nist.gov"
base_url_cve <- "https://cveawg.mitre.org/api/cve/"

for(vendor in all_vendors) {
	
	url <- paste0("https://nvd.nist.gov/vuln/search/results?results_type=overview&query=", vendor, "&search_type=all&form_type=Basic&isCpeNameSearch=false&orderBy=publishDate&orderDir=desc")
	CIShtml <- read_html(url)
	
	

	links <- html_nodes(CIShtml, "a") %>% html_attr("href")
	for(link in links){
	
		if (grepl("/CVE-\\d+-\\d+", link)){
			all_links <- append(all_links, link)
			source <- append(source, vendor)
		}
	}

	#Populate rows in data frame with CVE
	cvematch <- gregexpr("CVE-\\d+-\\d+", all_links)
	result <- regmatches(all_links, cvematch)
	all_cve <- append(all_cve, result)
	
	#CREATE DATA FRAME

	df2 <- data.frame(
	Key = NA,
	Date_Entered = NA,
	Summary = NA,
    	Description = NA,
    	Status = NA,
    	Due_date = NA,
    	Priority = NA,
    	Source = NA,
    	Source_type = NA,
    	Source_ID = NA,
    	Affected_Programs = NA,
    	Assignee = NA,
    	Business_Owner = NA,
    	Executive_Sponsor = NA,
    	Impact = NA,
    	Effort = NA,
    	Discovered_On = NA,
    	Closed_On = NA,
    	Action_Plan = NA,
    	Members = NA,
    	CVE = NA,
    	Departments = NA,
    	Detection_Method_Source = NA,
    	Exploited = NA,
    	Product_Type = NA,
    	stringsAsFactors = FALSE

	)

	df1 <- data.frame(
	Key = NA,
    	Summary = NA,
    	Description = NA,
    	Status = NA,
    	Due_date = NA,
    	Priority = "Medium",
    	Source = NA,
    	Source_type = "Label",
    	Source_ID = NA,
    	Affected_Programs = "Virginia Housing InfoSec Program",
    	Assignee = NA,
    	Business_Owner = NA,
    	Executive_Sponsor = NA,
    	Impact = NA,
    	Effort = "Medium",
    	Discovered_On = NA,
    	Closed_On = NA,
    	Action_Plan = NA,
    	Members = "Sequoia Lawson (sequoia.lawson@virginiahousing.com),
      Brie Carter (brittney.carter@virginiahousing.com), Clifton Dickens (clifton.dickens@virginiahousing.com), Melia Hill (melia.hill@virginiahousing.com), Raymond Kline (raymond.kline@virginiahousing.com)",
    	CVE = paste(unlist(result)),
    	Departments = NA,
    	Detection_Method_Source = "Other",
    	Exploited = NA,
    	Product_Type = NA,
    	stringsAsFactors = FALSE



	)
	
}


#PARSE THROUGH LINKED PAGE
for(i in seq_along(all_links)){
	
	linked_url <- paste0(base_url_nist, all_links[i])
	CIShtml_2 <- read_html(linked_url)
	
	#Desc Parser
	desc <- html_nodes(CIShtml_2, '[data-testid = "vuln-description"]') %>% html_text()
	all_desc <- append(all_desc, desc)
	df1$Description[i] <- paste(unlist(desc))
	
	#Date Parser
	date = html_node(CIShtml_2, '[data-testid = "vuln-published-on"]') %>% html_text()
	df1$Discovered_On[i] <- paste(unlist(date))
	
    	#Source/Product Parser
	df1$Source_ID[i] <- source[i]
	df1$Product_Type[i] <- source[i]
	if(grepl("Cisco", source[i]) | grepl("Mozilla", source[i])){
		df1$Source_ID[i] <- "Networking"
		df1$Product_Type[i] <- "Networking"
	}

	#Impact Parser
	impact_label_NIST = html_node(CIShtml_2, '[data-testid = "vuln-cvss3-panel-score"]') %>% html_text()
	impact_label_CNA = html_node(CIShtml_2, '[data-testid = "vuln-cvss3-cna-panel-score"]') %>% html_text()

	if(!(is.na(impact_label_NIST))) {
		
		impact = case_when(
			grepl("LOW", impact_label_NIST) ~ "Low",
			grepl("MEDIUM", impact_label_NIST) ~ "Medium",
			grepl("HIGH", impact_label_NIST) ~ "High",
			grepl("CRITICAL", impact_label_NIST) ~ "Highest",
			TRUE ~ "Unknown"

		)
	} else {
		
		impact = case_when(
			grepl("LOW", impact_label_CNA) ~ "Low",
			grepl("MEDIUM", impact_label_CNA) ~ "Medium",
			grepl("HIGH", impact_label_CNA) ~ "High",
			grepl("CRITICAL", impact_label_CNA) ~ "Highest",
			TRUE ~ "Unknown"

		)		

	}
	df1$Impact[i] <- impact
	
	#Exploited Parser	
	exploit = html_node(CIShtml_2, "#vulnCisaExploit") %>% html_text()
	
	if(is.na(exploit)){
		df1$Exploited[i] <- "No"

	} else {
		df1$Exploited[i] <- "Yes"
	}	
	
}

#PARSE THROUGH LINKED CVE PAGE
for(i in seq_along(df1$CVE)){

	linked_cve_url <- paste0(base_url_cve, df1$CVE[i])
	CIShtml_3 <- read_html(linked_cve_url)
	
	#Title Parser
	title_orig = CIShtml_3 %>% html_text()
	title_remove = sub('\"title\":\"CISA ADP Vulnrichment.*', '', title_orig)
	title_clean = sub('.*\"title\":\"', '', title_remove)
	
	title_final = sub('\".*', '', title_clean)
	
	if(nchar(title_final) < 2){
		title_clean <- sub('.*description":"', '', title_remove)
		title_final <- sub('".*', '', title_clean)
	}
	df1$Summary[i] <- title_final

}


writeData(wb, 'New NVD', unique(df1))

#Living Document
if(length(df2) > 0){ #If Sheet 2 is not empty, may be able to delete if

	df2 <- read.xlsx(excel_file, sheet = 'Entered Vul.')
	writeData(wb, 'Entered Vul.', unique(df2))
	#Compare new data with data in sheet 2 and only keep unique data
	if(any(df1[,20] %in% df2[,20])){
		dff <- anti_join(df1, df2, by = "CVE")
		
		

	}
}

#remove old sheet data to prevent duplicate entries on app. run
removeWorksheet(wb, 'New NVD')
addWorksheet(wb, 'New NVD')
writeData(wb, 'New NVD', unique(dff))

#Save to Excel
saveWorkbook(wb, 'CVE_Test-Table-New.xlsx', overwrite = TRUE)
#openXL(wb)


