library(rvest)
library(tidyverse)
library(openxlsx)
library(dplyr)

#For Palo Alto parse through advisory page

#Take URL and put into rvest, which is beautifulsoup equivalent. It will read the url
url <- "https://security.paloaltonetworks.com"
df1 <- data.frame()
all_links <- c()
all_titles <- c()
clean_titles <- c()
imp_list <- c()
imp_clean <- c()


for(page_result in seq(from = 1, to = 3)){
url = paste0("https://security.paloaltonetworks.com/?page=", page_result)
print(url)



CIShtml <- read_html(url)

#Title Parser
#Equivalent of .find_all and .get text in one line
list = html_nodes(CIShtml, "a")
titles <- html_text(list, trim = TRUE)
cve_titles <- titles[grepl("CVE-", titles)] #get titles related to CVE only
all_titles <- append(all_titles, cve_titles)
clean_titles <- str_replace_all(cve_titles, "CVE-\\d+-\\d+\n", "")






#put info into data frame
df1 <- rbind(df1, data.frame(
	Key = NA,
	Summary = clean_titles,
	Description = NA,
	Status = NA,
	Due_date = NA,
 	Priority = "Medium",
	Source = "Networking",
	Source_type = "Label",
	Source_ID = "Networking",
	Affected_Programs = "Virginia Housing InfoSec Program v2.0",
	Assignee = NA,
	Business_Owner = NA,
	Executive_Sponsor = NA,
	Impact = NA,
	Effort = "Medium",
	Discovered_On = NA,
	Closed_On = NA,
	Action_Plan = NA,
	Members = "Sequoia Lawson (sequoia.lawson@virginiahousing.com),
    Brie Carter (brittney.carter@virginiahousing.com), Clifton Dickens (clifton.dickens@virginiahousing.com), Melia Hill (melia.hill@virginiahousing.com), Raymond Kline (raymond.kline@virginiahousing.com)",
	CVE = NA,
	Departments = NA,
	Detection_Method_Source = "Other",
	Exploited = NA,
	Product_Type = "Networking",
	stringsAsFactors = FALSE

))

#CVE Parser
for(i in seq_along(all_titles)){
	cve <- gregexpr("CVE-\\d+-\\d+", all_titles[i])
	result <- regmatches(unique(all_titles[i]), cve)
	if(length(result) > 0){
		df1$CVE[i] <- paste(unlist(result), collapse = ",")
	} else {
		df1$CVE <- NA
}
}


#Desc Parser
link = html_nodes(CIShtml, ".tbl-salist-wide, a") %>% html_attr("href")
linked_url <- paste0("https://security.paloaltonetworks.com", link)
cve_url <- linked_url[grepl("CVE-", linked_url)]
all_links <- c(all_links, unique(cve_url))



}




for(i in seq_along(all_links)){

#Both desc and date will probably use following-sibling xpath func

	file <- file.path(all_links[i])
	CIShtml_2 <- read_html(file)
	desc <- html_node(CIShtml_2, ".pad") %>% html_text()
	desc_clean <-  sub(".*Description", "", desc)
	desc_final <- sub("Product Status.*", " ", desc_clean)
	df1$Description[i] <- paste(desc_final, collapse = "")
	

	

	#Exploited Parser
	if(grepl("not aware", desc)){
		df1$Exploited[i] = "No"

	} else{
		df1$Exploited[i] = "Yes"
	}

	#Impact Parser
	impact_text = html_nodes(CIShtml_2, "h3") %>% html_text()

	impact = case_when(
		grepl("LOW", impact_text) ~ "LOW",
		grepl("MEDIUM", impact_text) ~ "MEDIUM",
		grepl("HIGH", impact_text) ~ "HIGH",
		grepl("CRITICAL", impact_text) ~ "HIGHEST",
		grepl("Informational", all_titles[i]) ~ "LOWEST"
		
	) 
	
	imp_list <- append(imp_list, impact)
	imp_clean <- imp_list[!is.na(imp_list)]
	for(i in seq_along(imp_clean)){
		if(length(imp_clean[i]) > 0){
			df1$Impact[i] <- paste(unlist(imp_clean[i]))
		} 

	}
	print(all_titles[i])
	
	#Date Parser

	dates = html_node(CIShtml_2, ".date-tt")
	datematch <- html_text(dates, trim = TRUE)
	dates_clean <- gsub('-', '/', datematch)
	df1$Discovered_On[i] <- paste(dates_clean, collapse = "")

}





print(df1$Impact[31])
print(df1$Summary[31])

#export to excel
df1[is.na(df1)]<-''
write.xlsx(unique(df1), 'CVE_Palo_Table.xlsx')
