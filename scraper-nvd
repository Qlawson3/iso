#PARSE THROUGH LINKED PAGE
for(i in seq_along(all_links)){
	linked_url <- paste0(base_url, all_links[i])
	CIShtml_2 <- read_html(linked_url)
	
	#Desc Parser
	desc <- html_nodes(CIShtml_2, '[data-testid = "vuln-description"]') %>% html_text()
	df1$Description[i] <- paste(unlist(desc))
	
	#Date Parser
	date = html_node(CIShtml_2, '[data-testid = "vuln-published-on"]') %>% html_text()
	df1$Discovered_On[i] <- paste(unlist(date))
	print(date)
    

	#Impact Parser
	impact_label_NIST = html_node(CIShtml_2, '[data-testid = "vuln-cvss3-panel-score"]') %>% html_text()
	impact_label_CNA = html_node(CIShtml_2, '[data-testid = "vuln-cvss3-cna-panel-score"]') %>% html_text()

	if(!(is.na(impact_label_NIST))) {
		
		impact = case_when(
			grepl("LOW", impact_label_NIST) ~ "Low",
			grepl("MEDIUM", impact_label_NIST) ~ "Medium",
			grepl("HIGH", impact_label_NIST) ~ "High",
			grepl("CRITICAL", impact_label_NIST) ~ "Highest",
			TRUE ~ "Unknown"

		)
	} else {
		
		impact = case_when(
			grepl("LOW", impact_label_CNA) ~ "Low",
			grepl("MEDIUM", impact_label_CNA) ~ "Medium",
			grepl("HIGH", impact_label_CNA) ~ "High",
			grepl("CRITICAL", impact_label_CNA) ~ "Highest",
			TRUE ~ "Unknown"

		)		

	}
	df1$Impact[i] <- impact
	
	#Exploited Parser	
	exploit = html_node(CIShtml_2, "#vulnCisaExploit") %>% html_text()
	
	if(is.na(exploit)){
		df1$Exploited[i] <- "No"

	} else {
		df1$Exploited[i] <- "Yes"
	}


	
}



